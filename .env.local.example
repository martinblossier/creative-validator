# --- Google Service Account (used for both Drive & Sheets) ---
# Paste the FULL JSON key of your service account as a single-line string.
# The Drive folder AND the Google Sheet must both be shared with this
# service account's client_email (found inside the JSON key).
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}

# The ID of the Google Sheet used to log review results (from its URL)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Password used to access the /admin panel
ADMIN_PASSWORD=change_me

# Password used to access the /creative back-office (distinct from ADMIN_PASSWORD)
CREATIVE_PASSWORD=change_me

# --- Vercel KV (Redis) — created automatically when you add the Vercel KV
# integration to your project, or run `vercel env pull` to fetch them ---
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
